{
  "name": "cookbook",
  "version": "1.0.0",
  "main": "src/main.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "npx expo prebuild --platform android",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "test": "npx jest",
    "e2e:build": "npx detox build -c android.emu.debug",
    "e2e": "npx detox test -c android.emu.debug",
    "e2e:maestro": "maestro test e2e/maestro",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/firestore": "24.0.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-navigation/material-top-tabs": "7.4.24",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.12",
    "expo": "54.0.33",
    "expo-clipboard": "8.0.8",
    "expo-crypto": "15.0.8",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "3.0.9",
    "i18next": "26.0.8",
    "react": "19.1.0",
    "react-hook-form": "7.73.1",
    "react-i18next": "17.0.4",
    "react-native": "0.81.5",
    "react-native-pager-view": "6.9.1",
    "react-native-paper": "5.15.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-tab-view": "4.3.0",
    "tslib": "2.8.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "babel-jest": "30.3.0",
    "detox": "20.51.0",
    "firebase-admin": "^13.8.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "prettier": "3.8.3",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "@cookbook/domain/(.*)": "<rootDir>/src/domain/$1",
      "@cookbook/ui/(.*)": "<rootDir>/src/ui/$1"
    }
  }
}
